{
  "format_version": "1.20.30",
  "minecraft:block": {
    "description": {
      "identifier": "palm:pumpkin_stem",
      "menu_category": {
        "category": "none"
      },
      "states": {
        "palm:growth_stage": [0, 1, 2, 3, 4, 5, 6, 7]
      }
    },
    "components": {
      "minecraft:collision_box": false,
      "minecraft:geometry": "geometry.stem",
      "minecraft:light_dampening": 0,
      "minecraft:destructible_by_explosion": false,
      "minecraft:placement_filter": {
        "conditions": [
          {
            "allowed_faces": ["up"],
            "block_filter": ["palm:farmland"]
          }
        ]
      },
      "minecraft:loot": "loot_tables/blocks/pumpkin_young.json",
      "minecraft:random_ticking": {
        "on_tick": {
          "event": "palm:grow",
          "condition": "q.block_state('palm:growth_stage') < 7"
        }
      },
      "minecraft:queued_ticking": {
        "interval_range": [3600, 46000],
        "looping": true,
        "on_tick": {
          "event": "palm:plump",
          "condition": "q.block_state('palm:growth_stage') == 7"
        }
      },
      "minecraft:on_interact": {
        "event": "palm:fertilize",
        "condition": "q.is_item_name_any('slot.weapon.mainhand', 'minecraft:bone_meal') && q.block_state('palm:growth_stage') < 7"
      }
    },
    "events": {
      "palm:grow": {
        "set_block_state": {
          "palm:growth_stage": "q.block_state('palm:growth_stage') + 1"
        }
      },
      "palm:plump": {
        "run_command": {
          "command": "function plump"
        }
      },
      "palm:fertilize": {
        "decrement_stack": {},
        "set_block_state": {
          "palm:growth_stage": "q.block_state('palm:growth_stage') + Math.random(1, 7 - q.block_state('palm:growth_stage'))"
        },
        "run_command": {
          "command": [
            "particle minecraft:crop_growth_emitter ~~~",
            "playsound item.bone_meal.use @a ~~~"
          ]
        }
      }
    },
    "permutations": [
      {
        "condition": "q.block_state('palm:growth_stage') == 0",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "stem_stage_0",
              "render_method": "alpha_test",
              "face_dimming": false,
              "ambient_occlusion": false
            }
          },
          "minecraft:selection_box": {
            "origin": [-2, 0, -2],
            "size": [4, 2, 4]
          }
        }
      },
      {
        "condition": "q.block_state('palm:growth_stage') == 1",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "stem_stage_1",
              "render_method": "alpha_test",
              "face_dimming": false,
              "ambient_occlusion": false
            }
          },
          "minecraft:selection_box": {
            "origin": [-2, 0, -2],
            "size": [4, 3, 4]
          }
        }
      },
      {
        "condition": "q.block_state('palm:growth_stage') == 2",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "stem_stage_2",
              "render_method": "alpha_test",
              "face_dimming": false,
              "ambient_occlusion": false
            }
          },
          "minecraft:selection_box": {
            "origin": [-2, 0, -2],
            "size": [4, 5, 4]
          }
        }
      },
      {
        "condition": "q.block_state('palm:growth_stage') == 3",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "stem_stage_3",
              "render_method": "alpha_test",
              "face_dimming": false,
              "ambient_occlusion": false
            }
          },
          "minecraft:selection_box": {
            "origin": [-2, 0, -2],
            "size": [4, 5, 4]
          }
        }
      },
      {
        "condition": "q.block_state('palm:growth_stage') == 4",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "stem_stage_4",
              "render_method": "alpha_test",
              "face_dimming": false,
              "ambient_occlusion": false
            }
          },
          "minecraft:selection_box": {
            "origin": [-2, 0, -2],
            "size": [4, 7, 4]
          }
        }
      },
      {
        "condition": "q.block_state('palm:growth_stage') == 5",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "stem_stage_5",
              "render_method": "alpha_test",
              "face_dimming": false,
              "ambient_occlusion": false
            }
          },
          "minecraft:selection_box": {
            "origin": [-2, 0, -2],
            "size": [4, 9, 4]
          }
        }
      },
      {
        "condition": "q.block_state('palm:growth_stage') == 6",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "stem_stage_6",
              "render_method": "alpha_test",
              "face_dimming": false,
              "ambient_occlusion": false
            }
          },
          "minecraft:selection_box": {
            "origin": [-2, 0, -2],
            "size": [4, 11, 4]
          }
        }
      },
      {
        "condition": "q.block_state('palm:growth_stage') == 7",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "stem_stage_7",
              "render_method": "alpha_test",
              "face_dimming": false,
              "ambient_occlusion": false
            }
          },
          "minecraft:selection_box": {
            "origin": [-2, 0, -2],
            "size": [4, 13, 4]
          },
          "minecraft:loot": "loot_tables/blocks/pumpkin_mature.json"
        }
      }
    ]
  }
}
