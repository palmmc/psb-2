{
  "format_version": "1.20.30",
  "minecraft:block": {
    "description": {
      "identifier": "palm:sweet_berry_bush",
      "menu_category": {
        "category": "none"
      },
      "states": {
        "palm:growth_stage": [0, 1, 2, 3, 4, 5, 6, 7]
      }
    },
    "components": {
      "minecraft:collision_box": false,
      "minecraft:geometry": "geometry.bush",
      "minecraft:light_dampening": 0,
      "minecraft:destructible_by_explosion": false,
      "minecraft:placement_filter": {
        "conditions": [
          {
            "allowed_faces": ["up"],
            "block_filter": ["minecraft:grass"]
          }
        ]
      },
      "minecraft:loot": "loot_tables/blocks/sweet_berry_bush_young.json",
      "minecraft:random_ticking": {
        "on_tick": {
          "event": "palm:grow",
          "condition": "q.block_state('palm:growth_stage') < 7"
        }
      },
      "minecraft:on_interact": {
        "event": "palm:fertilize",
        "condition": "q.is_item_name_any('slot.weapon.mainhand', 'minecraft:bone_meal') && q.block_state('palm:growth_stage') < 7"
      }
    },
    "events": {
      "palm:grow": {
        "set_block_state": {
          "palm:growth_stage": "q.block_state('palm:growth_stage') + 1"
        }
      },
      "palm:fertilize": {
        "decrement_stack": {},
        "set_block_state": {
          "palm:growth_stage": "q.block_state('palm:growth_stage') + Math.random(1, 7 - q.block_state('palm:growth_stage'))"
        },
        "run_command": {
          "command": [
            "particle minecraft:crop_growth_emitter ~~~",
            "playsound item.bone_meal.use @a ~~~"
          ]
        }
      }
    },
    "permutations": [
      {
        "condition": "q.block_state('palm:growth_stage') == 0",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "sweet_berry_bush_stage_0",
              "render_method": "alpha_test",
              "face_dimming": false,
              "ambient_occlusion": false
            }
          },
          "minecraft:selection_box": {
            "origin": [-3, 0, -3],
            "size": [6, 6, 6]
          }
        }
      },
      {
        "condition": "q.block_state('palm:growth_stage') == 1",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "sweet_berry_bush_stage_1",
              "render_method": "alpha_test",
              "face_dimming": false,
              "ambient_occlusion": false
            }
          },
          "minecraft:selection_box": {
            "origin": [-7, 0, -7],
            "size": [14, 14, 14]
          }
        }
      },
      {
